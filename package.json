{
  "name": "coderdojo-lessons-specdojo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "push:develop": "git push origin project/prj-0001/develop",
    "push:lessons": "git -C ../coderdojo-lessons push origin develop",
    "orch:opus": "specdojo orchestrator launch --provider claude -- --agent specdojo-orchestrator --model opus",
    "orch:sonnet": "specdojo orchestrator launch --provider claude -- --agent specdojo-orchestrator --model sonnet",
    "orch:codex": "specdojo orchestrator launch --provider codex -- \"$(cat .specdojo/codex/orchestrator.md)\"",
    "orch:opencode": "specdojo orchestrator launch --provider opencode -- --agent specdojo-orchestrator",
    "orch:agy": "specdojo orchestrator launch --provider antigravity -- -i \"$(cat .specdojo/antigravity/orchestrator.md)\"",
    "orch:copilot": "specdojo orchestrator launch --provider copilot -- --agent specdojo-orchestrator",
    "prepare": "lefthook install && node tools/grade/enable-multirepo-grade.mjs",
    "orch:flash": "specdojo orchestrator launch --provider antigravity -- --model gemini-3.8-flash-high -i \"$(cat .specdojo/antigravity/orchestrator.md)\"",
    "orch:sol": "specdojo orchestrator launch --provider codex -- -m gpt-6.1-sol \"$(cat .specdojo/codex/orchestrator.md)\"",
    "orch:luna": "specdojo orchestrator launch --provider codex -- -m gpt-6-luna \"$(cat .specdojo/codex/orchestrator.md)\"",
    "docs:generate": "specdojo build",
    "docs:dev": "npm run docs:generate && specdojo-docs-site dev . --host 0.0.0.0 --port 5173",
    "docs:build": "npm run docs:generate && specdojo-docs-site build .",
    "docs:build:mermaid": "specdojo-docs-site mermaid .",
    "orch:argon": "specdojo orchestrator launch --provider antigravity -- --model gemini-4-argon-medium -i \"$(cat .specdojo/antigravity/orchestrator.md)\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "js-yaml": "^5.5.0",
    "lefthook": "^2.2.2",
    "markdownlint-cli": "^0.49.1",
    "playwright-chromium": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-slidev": "^1.0.5",
    "scratchblocks": "^3.7.1",
    "slidev-theme-neversink": "^0.4.1",
    "specdojo": "^0.9.2"
  },
  "dependencies": {
    "@specdojo/docs-lint": "^0.2.1",
    "@specdojo/docs-site": "^0.2.1"
  }
}
