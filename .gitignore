# 依存と specdojo の生成物（specdojo config init が追記）
node_modules/
.specdojo/doc-index.json
docs/**/generated/*
!docs/**/generated/.gitkeep
docs/**/execution/exec/.locks/

# 投影スライドの kata の表示に使う作業用のディレクトリ（tools/preview-lsd.sh）
/tmp/

# VitePress (@specdojo/docs-site) のビルド出力とキャッシュ
/.vitepress/dist
/.vitepress/cache
/public/mermaid
/specdojo-kata-staging/

.specdojo/specdojo.local.config.json
